{
  "name": "ai-finance-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "server": "node --env-file-if-exists=.env.local server/index.js",
    "server:watch": "node --env-file-if-exists=.env.local --watch --watch-preserve-output server/index.js",
    "build": "vite build",
    "test": "node --test",
    "lint": "oxlint",
    "smoke": "node scripts/smoke.mjs",
    "verify": "pnpm run test && pnpm run lint && pnpm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
